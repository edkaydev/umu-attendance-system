// UMU Attendance System — Prisma Schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────

// Campuses are FIXED university locations and live in code (constants/campuses.ts),
// not in the database. Faculties reference a campus by its code.
model Faculty {
  id                  String              @id @default(uuid())
  campusCode          String              @db.VarChar(20)
  name                String              @db.VarChar(100)
  code                String              @db.VarChar(20)
  isActive            Boolean             @default(true)
  programmes          Programme[]
  courseUnits         CourseUnit[]
  sharedCourseUnits   CourseUnitFaculty[]
  users               User[]
  lecturerMemberships LecturerFaculty[] @relation("LecturerFacultyMemberships")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([campusCode, code])
  @@map("faculties")
}

model Programme {
  id              String           @id @default(uuid())
  facultyId       String
  faculty         Faculty          @relation(fields: [facultyId], references: [id])
  name            String           @db.VarChar(150)
  code            String           @db.VarChar(20)
  isActive        Boolean          @default(true)
  curriculumUnits CurriculumUnit[]
  electiveRequirements ElectiveRequirement[]
  students        User[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([facultyId, code])
  @@map("programmes")
}

model CourseUnit {
  id                  String               @id @default(uuid())
  facultyId           String
  faculty             Faculty              @relation(fields: [facultyId], references: [id])
  code                String               @db.VarChar(20)
  name                String               @db.VarChar(150)
  isActive            Boolean              @default(true)
  curriculumUnits     CurriculumUnit[]
  enrollments         Enrollment[]
  lecturerAssignments LecturerAssignment[]
  sessions            Session[]
  attendanceAlerts    AttendanceAlert[]
  sharedFaculties     CourseUnitFaculty[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([facultyId, code])
  @@map("course_units")
}

/// Additional faculties that share a course unit (beyond the owning faculty).
model CourseUnitFaculty {
  id           String     @id @default(uuid())
  courseUnitId String
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  facultyId    String
  faculty      Faculty    @relation(fields: [facultyId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([courseUnitId, facultyId])
  @@map("course_unit_faculties")
}

// Maps a course unit to a Programme + Year + Semester
// Allows the same course unit to be shared across programmes
model CurriculumUnit {
  id           String     @id @default(uuid())
  courseUnitId String
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  programmeId  String
  programme    Programme  @relation(fields: [programmeId], references: [id])
  year         Int        @db.TinyInt
  semester     Int        @db.TinyInt
  // Electives are offered to students of this path cell — they pick at least
  // ElectiveRequirement.minPick of them; core units are enrolled automatically.
  isElective   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([courseUnitId, programmeId, year, semester])
  @@map("curriculum_units")
}

// How many electives students of a path cell (programme/year/semester) must take.
model ElectiveRequirement {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  year        Int       @db.TinyInt
  semester    Int       @db.TinyInt
  minPick     Int       @default(1) @db.TinyInt

  @@unique([programmeId, year, semester])
  @@map("elective_requirements")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  googleId        String?  @unique @db.VarChar(100)
  email           String   @unique @db.VarChar(150)
  password        String?  @db.VarChar(255)
  fullName        String   @db.VarChar(100)
  role            Role
  // Faculty link (primary faculty for lecturers — full membership list in LecturerFaculty)
  facultyId       String?
  faculty         Faculty? @relation(fields: [facultyId], references: [id])
  // Student-only fields
  programmeId     String?
  programme       Programme? @relation(fields: [programmeId], references: [id])
  year            Int?       @db.TinyInt
  semester        Int?       @db.TinyInt
  academicYear    String?    @db.VarChar(10)
  regNumber       String?    @unique @db.VarChar(30)
  studentNumber   String?    @unique @db.VarChar(30)
  // Profile state
  profileComplete Boolean  @default(false)
  isActive        Boolean  @default(true)
  // Onboarding: has the user seen (or skipped) the guided tour?
  hasCompletedTour Boolean @default(false)
  // Security: accounts created with a temporary password must change it on first login
  mustChangePassword Boolean @default(false)
  // Set for demo/seeded accounts: the bootstrap resets these to the known
  // demo password on startup. Cleared when the user changes their own password.
  demoManaged        Boolean @default(false) @map("demo_managed")
  // Relations
  enrollments          Enrollment[]
  lecturerAssignments  LecturerAssignment[] @relation("LecturerAssignments")
  assignmentsMade      LecturerAssignment[] @relation("AssignedByAdmin")
  lecturerFaculties    LecturerFaculty[]     @relation("LecturerFaculties")
  sessionsOpened       Session[]
  attendanceRecords    AttendanceRecord[]
  attendanceEdits      AttendanceEdit[]
  attendanceAlerts     AttendanceAlert[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  excuseRequests       ExcuseRequest[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("users")
}

enum Role {
  system_admin
  faculty_admin
  lecturer
  student
}

// ─────────────────────────────────────────────
// ENROLMENT & ASSIGNMENT
// ─────────────────────────────────────────────

// Student ↔ CourseUnit link (auto-created on profile setup)
model Enrollment {
  id           String     @id @default(uuid())
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])
  courseUnitId String
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  academicYear String     @db.VarChar(10)
  semester     Int        @db.TinyInt
  enrolledAt   DateTime   @default(now())

  @@unique([studentId, courseUnitId, academicYear, semester])
  @@index([studentId, academicYear, semester])
  @@map("enrollments")
}

// Lecturer ↔ CourseUnit link (set by Faculty Admin)
model LecturerAssignment {
  id           String     @id @default(uuid())
  lecturerId   String
  lecturer     User       @relation("LecturerAssignments", fields: [lecturerId], references: [id])
  courseUnitId String
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  academicYear String     @db.VarChar(10)
  semester     Int        @db.TinyInt
  assignedById String
  assignedBy   User       @relation("AssignedByAdmin", fields: [assignedById], references: [id])
  assignedAt   DateTime   @default(now())

  @@unique([lecturerId, courseUnitId, academicYear, semester])
  @@index([courseUnitId, academicYear, semester])
  @@map("lecturer_assignments")
}

// Lecturer ↔ Faculty membership — a lecturer teaches from up to 3 faculties;
// the first (isPrimary) is mirrored onto users.facultyId for fast scoping.
model LecturerFaculty {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("LecturerFaculties", fields: [userId], references: [id], onDelete: Cascade)
  facultyId String
  faculty   Faculty  @relation("LecturerFacultyMemberships", fields: [facultyId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, facultyId])
  @@index([facultyId])
  @@map("lecturer_faculties")
}

// ─────────────────────────────────────────────
// SESSIONS
// ─────────────────────────────────────────────

model Session {
  id               String            @id @default(uuid())
  courseUnitId     String
  courseUnit       CourseUnit        @relation(fields: [courseUnitId], references: [id])
  lecturerId       String
  lecturer         User              @relation(fields: [lecturerId], references: [id])
  academicYear     String            @db.VarChar(10)
  semester         Int               @db.TinyInt
  code             String            @db.VarChar(8)
  codeExpiresAt    DateTime
  status           SessionStatus     @default(open)
  venue            String?           @db.VarChar(100)
  /// Zoom / Google Meet / Teams join link (online sessions only, null otherwise)
  meetingLink      String?           @db.VarChar(500)
  mode             SessionMode       @default(physical)
  startsAt         DateTime?
  classDuration    Int               @default(60) /// class length in minutes (max 180); sessions always auto-close
  codeTtl          Int?              /// initial code validity in minutes (5–15); null = 5 default
  /// Lecturer GPS captured when the physical session was opened (null for online sessions)
  lecturerLat      Decimal?          @db.Decimal(10, 7)
  lecturerLng      Decimal?          @db.Decimal(10, 7)
  /// Proximity radius (metres) a student must be within relative to the lecturer (null = campus-only check)
  proximityRadius  Int?
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  attendanceRecords AttendanceRecord[]
  excuseRequests   ExcuseRequest[]

  @@index([code])
  @@index([courseUnitId, status])
  @@index([lecturerId, status])
  @@map("sessions")
}

enum SessionStatus {
  open
  closed
}

enum SessionMode {
  physical
  online
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model AttendanceRecord {
  id          String           @id @default(uuid())
  sessionId   String
  session     Session          @relation(fields: [sessionId], references: [id])
  studentId   String
  student     User             @relation(fields: [studentId], references: [id])
  status      AttendanceStatus
  checkedInAt DateTime?
  createdAt   DateTime         @default(now())
  edits       AttendanceEdit[]

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId, status])
  @@map("attendance_records")
}

enum AttendanceStatus {
  present
  absent
  excused
}

// Audit trail for every manual attendance change
model AttendanceEdit {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  changedById        String
  changedBy          User             @relation(fields: [changedById], references: [id])
  oldStatus          AttendanceStatus
  newStatus          AttendanceStatus
  reason             String           @db.Text
  changedAt          DateTime         @default(now())

  @@map("attendance_edits")
}

// Tracks 80% warning and 75% critical alerts sent to prevent duplicates
model AttendanceAlert {
  id            String     @id @default(uuid())
  studentId     String
  student       User       @relation(fields: [studentId], references: [id])
  courseUnitId  String
  courseUnit    CourseUnit @relation(fields: [courseUnitId], references: [id])
  alertType     AlertType
  attendancePct Decimal    @db.Decimal(5, 2)
  sentAt        DateTime   @default(now())
  resolved      Boolean    @default(false)

  @@map("attendance_alerts")
}

enum AlertType {
  warning   // fired at 80%
  critical  // fired at 75%
}

// ─────────────────────────────────────────────
// EXCUSE REQUESTS
// ─────────────────────────────────────────────

/// A student submits an excuse before or during a session when they cannot attend.
/// The lecturer reviews it on the live screen and approves (excused) or rejects (absent).
/// Pending requests that are not acted on by session close are auto-marked Absent.
model ExcuseRequest {
  id        String            @id @default(uuid())
  studentId String
  student   User              @relation(fields: [studentId], references: [id])
  sessionId String
  session   Session           @relation(fields: [sessionId], references: [id])
  reason    String            @db.Text
  status    ExcuseRequestStatus @default(pending)
  reviewedById String?
  reviewedAt    DateTime?
  createdAt DateTime          @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId, status])
  @@index([studentId])
  @@map("excuse_requests")
}

enum ExcuseRequestStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────────
// AUTH & AUDIT
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @db.VarChar(255)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(50)
  targetType String   @db.VarChar(50)
  targetId   String   @db.VarChar(36)
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
