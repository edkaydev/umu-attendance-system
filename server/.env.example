NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=mysql://umu_user:password@localhost:3306/umu_attendance

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# JWT
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# First System Admin bootstrap
# Set this to a @umu.ac.ug Google account email.
# On the very first Google login with this email, the account is automatically
# created as System Admin — no seed script needed.
ADMIN_BOOTSTRAP_EMAIL=your.admin@umu.ac.ug

# Assets
# PDF logo is committed at server/assets/umu-logo.svg — no env var needed.

# Geo-fencing (physical session check-ins must be within the campus radius)
CAMPUS_LAT=0.00389
CAMPUS_LNG=32.01353
CAMPUS_RADIUS_METERS=500
