NODE_ENV=production
PORT=4000
CLIENT_URL=https://YOUR-DOMAIN

# Database
# Password must match MYSQL_PASSWORD in the root .env file.
# If the password contains special chars (#, @, %), URL-encode them (e.g. # → %23).
DATABASE_URL=mysql://umu_user:change-this-db-password@db:3306/umu_attendance

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://YOUR-DOMAIN/api/auth/google/callback

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email (Google SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=attendance@umu.ac.ug
SMTP_PASS=your-google-app-password
ALERT_FROM_EMAIL=attendance@umu.ac.ug
ALERT_FROM_NAME=UMU Attendance System

# Moodle Integration (read-only sync)
# MOODLE_BASE_URL    — Base URL of the Moodle instance, no trailing slash.
#                      e.g. https://moodle.umu.ac.ug
# MOODLE_WS_TOKEN    — Permanent web service token from Moodle admin.
#                      Run devops/scripts/moodle/setup-webservice.php to generate.
#                      NEVER commit a real token. NEVER expose to the frontend.
# MOODLE_WS_SERVICE  — Web service shortname (default: umu_attendance_sync).
#                      Only override if ICT uses a different shortname.
MOODLE_BASE_URL=https://moodle.umu.ac.ug
MOODLE_WS_TOKEN=replace-with-token-from-setup-webservice-php
MOODLE_WS_SERVICE=umu_attendance_sync

# Assets
# PDF logo is committed at server/assets/umu-logo.svg and embedded as base64 — no env var needed.

# Geo-fencing (physical session check-ins must be within the campus radius)
CAMPUS_LAT=0.00389
CAMPUS_LNG=32.01353
CAMPUS_RADIUS_METERS=500
# How close (metres) a student must be to the lecturer when checking in physically (default 50)
LECTURER_PROXIMITY_RADIUS_METERS=50

# First System Admin account (pre-registered by email — signs in via Google OAuth)
# Run: docker compose exec app npm run seed:admin
SEED_ADMIN_EMAIL=admin@umu.ac.ug
SEED_ADMIN_NAME=System Administrator

# Set to false in production to disable demo data auto-seeding on empty database
SEED_ON_EMPTY=false
